<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="PolyTrans" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
    <description>
        Blocking profile: the rules a WordPress.org review actually turns on — output
        escaping, input sanitisation, nonces, SQL, i18n, deprecated and discouraged APIs.

        Deliberately no formatting or indentation rules. The previous ruleset pulled in
        WordPress-Core wholesale, which demands tabs; the codebase uses spaces, so 35 251
        of its 35 661 findings were "tabs must be used" and the profile was useless as a
        gate. Formatting is not what a reviewer rejects a plugin over.
    </description>

    <file>includes/</file>
    <file>polytrans.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/includes/Debug/*</exclude-pattern>
    <exclude-pattern>*/includes/Menu/TagTranslation_temp.php</exclude-pattern>
    <exclude-pattern>*/coverage/*</exclude-pattern>
    <exclude-pattern>*.min.js</exclude-pattern>
    <exclude-pattern>*.min.css</exclude-pattern>

    <arg value="sp"/>
    <arg name="basepath" value="./"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="20"/>

    <config name="minimum_supported_wp_version" value="6.0"/>

    <!-- Security: escaping, sanitisation, nonces. The whole reason this profile exists. -->
    <rule ref="WordPress.Security"/>

    <!-- Our own sanitizers, so prompt and workflow input can be sanitised for real
         instead of annotated as "trusted admin input". sanitize_text_field() cannot be
         used on a prompt: it collapses the newlines and eats the markers that make the
         prompt work. See PolyTrans\Core\InputSanitizer for what these do keep out. -->
    <rule ref="WordPress.Security.ValidatedSanitizedInput">
        <properties>
            <property name="customSanitizingFunctions" type="array">
                <element value="sanitize_prompt_template"/>
                <element value="sanitize_input_deep"/>
            </property>
        </properties>
    </rule>

    <!-- Database access. Warnings for direct queries are expected (four custom tables);
         the errors are not, and this keeps them visible. -->
    <rule ref="WordPress.DB"/>

    <!-- Internationalisation, including the text domain. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="treetank-trans"/>
                <element value="default"/>
            </property>
        </properties>
    </rule>

    <!-- APIs WordPress asks you not to use, and the enqueue rules from the review email. -->
    <rule ref="WordPress.WP.DeprecatedFunctions"/>
    <rule ref="WordPress.WP.DeprecatedParameters"/>
    <rule ref="WordPress.WP.DeprecatedClasses"/>
    <rule ref="WordPress.WP.AlternativeFunctions"/>
    <rule ref="WordPress.WP.EnqueuedResources"/>
    <rule ref="WordPress.WP.GlobalVariablesOverride"/>
    <rule ref="WordPress.PHP.DevelopmentFunctions"/>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>

    <!-- Everything global must carry the plugin's prefix. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="treetank-trans"/>
                <element value="POLYTRANS"/>
                <element value="PolyTrans"/>
            </property>
        </properties>
    </rule>

    <!-- Basic hygiene that costs nothing to keep green. -->
    <rule ref="Generic.PHP.DisallowShortOpenTag"/>
    <rule ref="Generic.PHP.DisallowAlternativePHPTags"/>
    <rule ref="Squiz.PHP.Eval"/>
    <rule ref="PSR2.Files.EndFileNewline"/>
</ruleset>
