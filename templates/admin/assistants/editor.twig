{% set is_new = assistant.id == 0 %}
{% set current_provider = assistant.provider|default('openai') %}
{% set current_model = assistant.model|default('') %}

{# Note: Assets are enqueued in PHP before rendering this template #}

<div class="wrap">
    <h1>{{ (is_new ? __('Add New Assistant', 'treetank-trans') : __('Edit Assistant', 'treetank-trans'))|esc_html }}</h1>

    <form id="assistant-editor-form" method="post">
        {# This nonce field HTML is generated by WordPress and is safe to render as trusted form markup. #}
        {{ wp_nonce_field('polytrans_assistant_save', 'assistant_nonce')|raw }}
        <input type="hidden" name="assistant_id" value="{{ assistant.id|esc_attr }}">

        <table class="form-table" role="presentation">
            <tbody>
                <tr>
                    <th scope="row">
                        <label for="assistant-name">{{ __('Name', 'treetank-trans') }} <span class="required">*</span></label>
                    </th>
                    <td>
                        <input type="text" id="assistant-name" name="name" class="regular-text" value="{{ assistant.name|esc_attr }}" required>
                        <p class="description">{{ __('A descriptive name for this assistant.', 'treetank-trans') }}</p>
                    </td>
                </tr>

                <tr>
                    <th scope="row">
                        <label for="assistant-description">{{ __('Description', 'treetank-trans') }}</label>
                    </th>
                    <td>
                        <textarea id="assistant-description" name="description" class="large-text" rows="3">{{ assistant.description|default('')|esc_textarea }}</textarea>
                        <p>
                            <button type="button" id="assistant-generate-description-btn" class="button">
                                {{ __('Generate Description', 'treetank-trans') }}
                            </button>
                        </p>
                        <p class="description">{{ __('Short description of the assistant purpose. Prompt refinement uses this as the default primary purpose.', 'treetank-trans') }}</p>
                    </td>
                </tr>

                <tr>
                    <th scope="row">
                        <label for="assistant-provider">{{ __('Provider', 'treetank-trans') }} <span class="required">*</span></label>
                    </th>
                    <td>
                        <select id="assistant-provider" name="provider" required>
                            {% for provider_id, provider in available_assistant_providers %}
                                {% if provider %}
                                    <option value="{{ provider.id|esc_attr }}" {{ selected(assistant.provider|default('openai'), provider.id) }}>
                                        {{ provider.name|esc_html }}
                                    </option>
                                {% else %}
                                    <option value="{{ provider_id|esc_attr }}" disabled {{ selected(assistant.provider|default('openai'), provider_id) }}>
                                        {{ provider_id|capitalize|esc_html }} {{ __('(Not Available)', 'treetank-trans') }}
                                    </option>
                                {% endif %}
                            {% endfor %}
                        </select>
                        <p class="description">
                            {{ __('AI provider to use for this assistant. Only enabled providers with assistant support are shown.', 'treetank-trans') }}
                        </p>
                    </td>
                </tr>

                <tr>
                    <th scope="row">
                        <label for="assistant-model">{{ __('AI Model', 'treetank-trans') }}</label>
                    </th>
                    <td>
                        <select id="assistant-model" name="model" class="regular-text" data-selected-model="{{ current_model|esc_attr }}" data-provider="{{ current_provider|esc_attr }}">
                            <option value="" {{ current_model is empty ? 'selected' : '' }}>{{ __('Use Global Setting', 'treetank-trans') }}</option>
                            {% for group_name, group_models in models %}
                                <optgroup label="{{ group_name|esc_attr }}">
                                    {% for model_value, model_label in group_models %}
                                        <option value="{{ model_value|esc_attr }}" {{ current_model == model_value ? 'selected' : '' }}>{{ model_label|esc_html }}</option>
                                    {% endfor %}
                                </optgroup>
                            {% endfor %}
                        </select>
                        <button type="button" id="refresh-models" class="button" style="margin-left: 0.5em;" title="{{ __('Refresh models from provider API', 'treetank-trans')|esc_attr }}">
                            {{ __('Refresh', 'treetank-trans') }}
                        </button>
                        <p class="description">{{ __('Select the AI model to use for this assistant. "Use Global Setting" will use the default model from plugin settings.', 'treetank-trans') }}</p>
                    </td>
                </tr>

                <tr id="system-prompt-row" class="system-prompt-field-row">
                    <th scope="row">
                        <label for="assistant-system-prompt">{{ __('System Instructions', 'treetank-trans') }} <span class="required system-prompt-required">*</span></label>
                    </th>
                    <td class="workflow-field-with-variables">
                        <div id="system-prompt-editor-container"></div>
                        <p class="description">{{ __('Instructions that define how the assistant should behave. This is static and doesn\'t change between requests.', 'treetank-trans') }}</p>
                        <p class="description"><strong>{{ __('Example:', 'treetank-trans') }}</strong> "You are a content quality expert. Analyze posts for grammar, SEO, and readability. Always respond in JSON format."</p>
                        <p class="description system-prompt-not-supported" style="display:none; color: #d63638;">
                            <strong>{{ __('Note:', 'treetank-trans') }}</strong> 
                            {{ __('This provider does not support system prompts. Only the User Message Template will be used.', 'treetank-trans') }}
                        </p>
                    </td>
                </tr>

                <tr>
                    <th scope="row">
                        <label for="assistant-user-message">{{ __('User Message Template', 'treetank-trans') }}</label>
                    </th>
                    <td class="workflow-field-with-variables">
                        <div id="user-message-editor-container"></div>
                        <p class="description">{{ __('Template for the user message with dynamic data. Use Twig syntax for variables: {{ variable_name }}', 'treetank-trans') }}</p>
                        <p class="description"><strong>{{ __('Example:', 'treetank-trans') }}</strong> "Title: {{ title|esc_html }}\nContent: {{ content|esc_html }}\n\nPlease analyze this content."</p>
                    </td>
                </tr>

                <tr>
                    <th scope="row">
                        <label for="assistant-response-format">{{ __('Response Format', 'treetank-trans') }}</label>
                    </th>
                    <td>
                        <select id="assistant-response-format" name="response_format">
                            <option value="text" {{ selected(assistant.response_format|default('text'), 'text') }}>{{ __('Text', 'treetank-trans') }}</option>
                            <option value="json" {{ selected(assistant.response_format|default('text'), 'json') }}>{{ __('JSON', 'treetank-trans') }}</option>
                        </select>
                        <p class="description">{{ __('Expected response format from the assistant.', 'treetank-trans') }}</p>
                    </td>
                </tr>
                <tr id="expected-output-schema-row" style="display: none;">
                    <th scope="row">
                        <label for="assistant-expected-output-schema">{{ __('Expected Output Schema', 'treetank-trans') }}</label>
                    </th>
                    <td>
                        <textarea id="assistant-expected-output-schema" name="expected_output_schema" class="large-text code" rows="8" placeholder='{"field_name": "type"}'>{{ expected_output_schema_json|esc_textarea }}</textarea>
                        <p class="description">
                            {{ __('Define the expected JSON structure for AI responses. Format: {"field": "type"}', 'treetank-trans') }}<br>
                            <strong>{{ __('Supported types:', 'treetank-trans') }}</strong> string, number, array, object, boolean<br>
                            <strong>{{ __('Example:', 'treetank-trans') }}</strong> {"title": "string", "content": "string", "meta": "object"}
                        </p>
                    </td>
                </tr>

                <tr id="assistant-temperature-row" {% if not model_capabilities.temperature.supported %}style="display: none;"{% endif %}>
                    <th scope="row">
                        <label for="assistant-temperature">{{ __('Temperature', 'treetank-trans') }}</label>
                    </th>
                    <td>
                        <input type="number" id="assistant-temperature" name="config[temperature]" class="small-text"
                               min="{{ model_capabilities.temperature.min|esc_attr }}"
                               max="{{ model_capabilities.temperature.max|esc_attr }}"
                               step="{{ model_capabilities.temperature.step|esc_attr }}"
                               value="{{ assistant.config.temperature|default(model_capabilities.temperature.default)|esc_attr }}">
                        <p class="description assistant-temperature-description" data-base-description="{{ __('Controls randomness: lower = focused, higher = creative.', 'treetank-trans')|esc_attr }}">
                            {{ __('Controls randomness: lower = focused, higher = creative.', 'treetank-trans') }}
                            {% if model_capabilities.temperature.note %}{{ model_capabilities.temperature.note|esc_html }}{% endif %}
                        </p>
                    </td>
                </tr>

                <tr id="assistant-reasoning-effort-row" {% if not model_capabilities.reasoning %}style="display: none;"{% endif %}>
                    <th scope="row">
                        <label for="assistant-reasoning-effort">{{ __('Reasoning Effort', 'treetank-trans') }}</label>
                    </th>
                    <td>
                        <select id="assistant-reasoning-effort" name="config[reasoning_effort]">
                            <option value="">{{ __('Provider default', 'treetank-trans') }}</option>
                            {% for level in effort_levels %}
                                <option value="{{ level.value|esc_attr }}" {{ selected(current_effort|default(''), level.value) }}>{{ level.label|esc_html }}</option>
                            {% endfor %}
                        </select>
                        <p class="description assistant-reasoning-description">
                            {% if model_capabilities.reasoning %}
                                {{ model_capabilities.reasoning.note|esc_html }}
                            {% endif %}
                        </p>
                    </td>
                </tr>

                <tr id="assistant-capability-summary-row">
                    <th scope="row"></th>
                    <td>
                        <p class="description assistant-capability-summary">{{ capability_summary|esc_html }}</p>
                    </td>
                </tr>

            </tbody>
        </table>

        <div class="assistant-editor-actions">
            <button type="submit" class="button button-primary">
                {{ __('Save Assistant', 'treetank-trans') }}
            </button>
            <a href="{{ polytrans_admin_url('polytrans-assistants')|esc_url }}" class="button">
                {{ __('Cancel', 'treetank-trans') }}
            </a>
        </div>
    </form>

</div>
