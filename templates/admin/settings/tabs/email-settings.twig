{% set notification_allowed_domains = settings.notification_allowed_domains|default('') %}
{% set notification_allowed_domains_str = notification_allowed_domains is iterable ? notification_allowed_domains|join(', ') : notification_allowed_domains %}

<!-- Email Templates Section -->
<div class="translation-emails-row" style="display:flex;gap:2em;flex-wrap:wrap;">
    <div class="translation-email-col">
        <h2>{{ __('Reviewer Email Template', 'treetank-trans') }}</h2>
        <label for="reviewer_email_title"><strong>{{ __('Email Subject (Reviewer)', 'treetank-trans') }}</strong></label><br />
        <input type="text" id="reviewer_email_title" name="reviewer_email_title" value="{{ reviewer_email_title|esc_attr }}" style="width:100%" />
        <br><small>{{ __('Subject of the email sent to reviewer. You can use {title} for the post title.', 'treetank-trans') }}</small><br><br>
        {% set editor_settings_reviewer = {
            'textarea_name': 'reviewer_email',
            'textarea_rows': 6,
            'media_buttons': false,
            'teeny': true,
            'quicktags': true
        } %}
        {# This editor markup is generated by WordPress and is safe to render as trusted editor HTML. #}
        {{ wp_editor(reviewer_email, 'reviewer_email', editor_settings_reviewer)|raw }}
        <small>{{ __('Email sent to reviewer when translation is ready for review. Use {link} for the edit link and {title} for the post title. Note: Edit links will use the "Edit Link Base URL" from Advanced Settings if configured, which is recommended for background processes.', 'treetank-trans') }}</small>
    </div>
    <div class="translation-email-col">
        <h2>{{ __('Author Email Template (when translation is published)', 'treetank-trans') }}</h2>
        <label for="author_email_title"><strong>{{ __('Email Subject (Author)', 'treetank-trans') }}</strong></label><br />
        <input type="text" id="author_email_title" name="author_email_title" value="{{ author_email_title|esc_attr }}" style="width:100%" />
        <br><small>{{ __('Subject of the email sent to the author. You can use {title} for the post title.', 'treetank-trans') }}</small><br><br>
        {% set editor_settings_author = {
            'textarea_name': 'author_email',
            'textarea_rows': 6,
            'media_buttons': false,
            'teeny': true,
            'quicktags': true
        } %}
        {# This editor markup is generated by WordPress and is safe to render as trusted editor HTML. #}
        {{ wp_editor(author_email, 'author_email', editor_settings_author)|raw }}
        <small>{{ __('Email sent to the author when translation is published. Use {link} for the edit link and {title} for the post title. Note: Edit links will use the "Edit Link Base URL" from Advanced Settings if configured, which is recommended for background processes.', 'treetank-trans') }}</small>
    </div>
</div>

<hr style="margin: 2em 0;">

<!-- Notification Timing Section -->
<div class="notification-timing-section" style="margin-bottom: 2em; padding: 1em; background: #f9f9f9; border-left: 4px solid #2271b1;">
    <h2>{{ __('Notification Timing', 'treetank-trans') }}</h2>
    <p style="margin-top: 0;">
        {{ __('Control when email notifications are sent to reviewers and authors.', 'treetank-trans') }}
    </p>

    {% set notification_timing = settings.notification_timing|default('after_workflows') %}
    <div style="margin-bottom: 1em;">
        <label for="notification-timing"><strong>{{ __('Send notifications', 'treetank-trans') }}</strong></label><br>
        <select name="notification_timing" id="notification-timing" style="width:100%;max-width:400px;">
            <option value="after_workflows" {{ selected(notification_timing, 'after_workflows') }}>{{ __('After workflows complete (Recommended)', 'treetank-trans') }}</option>
            <option value="immediate" {{ selected(notification_timing, 'immediate') }}>{{ __('Immediately after translation', 'treetank-trans') }}</option>
        </select>
    </div>

    <p style="margin-bottom: 0; padding: 0.5em; background: #fff; border-left: 3px solid #72aee6;">
        <strong>{{ __('After workflows complete:', 'treetank-trans') }}</strong> {{ __('Notifications are sent after all post-processing workflows finish. Recipients see the final, processed content.', 'treetank-trans') }}<br>
        <strong>{{ __('Immediately:', 'treetank-trans') }}</strong> {{ __('Notifications are sent right after translation, before workflows run. Use if workflows take a long time and you want faster notifications.', 'treetank-trans') }}
    </p>
</div>

<!-- Notification Filters Section -->
<div class="notification-filters-section" style="margin-bottom: 2em; padding: 1em; background: #f9f9f9; border-left: 4px solid #2271b1;">
    <h2>{{ __('Author Notification Filters', 'treetank-trans') }}</h2>
    <p style="margin-top: 0;">
        {{ __('Control which authors receive email notifications when translations are completed. This is useful to prevent sending emails to external authors (e.g., guest contributors).', 'treetank-trans') }}
        <br>
        <strong>{{ __('Note:', 'treetank-trans') }}</strong> {{ __('Reviewer notifications are always sent (reviewers are internal users from settings).', 'treetank-trans') }}
    </p>
    
    <div style="margin-bottom: 1.5em;">
        <label for="notification_allowed_domains"><strong>{{ __('Allowed Email Domains', 'treetank-trans') }}</strong></label><br>
        <input type="text" name="notification_allowed_domains" id="notification_allowed_domains" value="{{ notification_allowed_domains_str|esc_attr }}" style="width: 100%; max-width: 500px;" placeholder="example.com, company.org">
        <br>
        <small>
            {{ __('Comma-separated list of allowed email domains (e.g., "example.com, company.org"). Only authors with emails from these domains will receive notifications. Leave empty to allow all domains.', 'treetank-trans') }}
        </small>
    </div>
    
    <p style="margin-bottom: 0; padding: 0.5em; background: #fff; border-left: 3px solid #72aee6;">
        <strong>{{ __('How it works:', 'treetank-trans') }}</strong><br>
        {{ __('If filter is set, only authors with emails from the specified domains will receive notifications.', 'treetank-trans') }}<br>
        {{ __('If no filter is set, all authors will receive notifications (default behavior).', 'treetank-trans') }}
    </p>
</div>
