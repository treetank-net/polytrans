            <code>{{ '{{ adjust_expected_output_schema }}' }}</code><span>{{ __('Boolean flag telling whether the adjuster may change output schema.', 'treetank-trans') }}</span>
            <code>{{ '{{ evaluations }}' }}</code><span>{{ __('Array of normalized evaluation items.', 'treetank-trans') }}</span>
            <code>{{ '{{ evaluations_json }}' }}</code><span>{{ __('Pretty JSON string with normalized evaluation items.', 'treetank-trans') }}</span>
