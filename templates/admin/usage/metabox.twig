{# Cost of the AI work on this post, read straight from the summary meta. #}

<div class="polytrans-usage-metabox">
    <span class="polytrans-usage-metabox__total">{{ total_display|esc_html }}</span>

    {% if summary.unpriced_calls > 0 %}
        <p class="polytrans-usage-metabox__note">
            {# Stated plainly: the figure above is short by whatever these cost. #}
            {{ summary.unpriced_calls|esc_html }} {{ __('calls had no price available', 'treetank-trans') }}
        </p>
    {% endif %}

    {% if languages|length > 0 %}
        <table>
            <tbody>
                {% for row in languages %}
                    <tr>
                        <td><strong>{{ row.label|upper|esc_html }}</strong></td>
                        <td class="num">{{ row.cost_display|esc_html }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if models|length > 0 %}
        <p class="polytrans-usage-metabox__note">
            {{ __('Models', 'treetank-trans') }}:
            {% for row in models %}{{ row.label|esc_html }}{% if not loop.last %}, {% endif %}{% endfor %}
        </p>
    {% endif %}

    <p class="polytrans-usage-metabox__note">
        {{ summary.calls|esc_html }} {{ __('calls', 'treetank-trans') }},
        {{ (summary.tokens_input + summary.tokens_output)|number_format(0, '.', ' ') }} {{ __('tokens', 'treetank-trans') }}
        {% if reasoning_share > 0 %}
            &middot; {{ reasoning_share|esc_html }}% {{ __('reasoning', 'treetank-trans') }}
        {% endif %}
    </p>

    <p class="polytrans-usage-metabox__note">
        <a href="{{ dashboard_url|esc_url }}">{{ __('All AI costs', 'treetank-trans') }} &rarr;</a>
    </p>
</div>
